{
    "name": "unsettlingtrend/trend_project",
    "description": "Composer template for a Trend personal site (Drupal 11, recipe-based install).",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://unsettlingtrend.com/",
    "authors": [
        { "name": "Chris Feragotti", "role": "Developer" }
    ],
    "repositories": [
        { "type": "composer", "url": "https://packages.drupal.org/8" },
        { "type": "composer", "url": "https://asset-packagist.org" },
        { "type": "vcs", "url": "https://gitlab.com/unsettlingtrend/trend_personal.git" },
        { "type": "vcs", "url": "https://gitlab.com/unsettlingtrend/ut_base.git" },
        { "type": "vcs", "url": "https://gitlab.com/unsettlingtrend/ut_utilities.git" },
        { "type": "vcs", "url": "https://gitlab.com/unsettlingtrend/ut_recipe.git" },
        {
            "type": "package",
            "package": {
                "name": "noli42/chosen",
                "version": "3.0.0",
                "type": "drupal-library",
                "dist": { "url": "https://github.com/noli42/chosen/releases/download/3.0.0/chosen-assets-v3.0.0.zip", "type": "zip" }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "bower-asset/photoswipe": "^5.4",
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.7",
        "drupal/add_content_by_bundle": "^1.0",
        "drupal/address": "^2.0",
        "drupal/admin_toolbar": "^3.0",
        "drupal/auto_entitylabel": "^3.4",
        "drupal/better_exposed_filters": "^7.1@beta",
        "drupal/block_content_template": "^1.5",
        "drupal/block_field": "^1.0@RC",
        "drupal/captcha": "^2.0",
        "drupal/chosen": "^5.0",
        "drupal/components": "^3.1",
        "drupal/config_split": "^2.0@RC",
        "drupal/cookies": "^2.0@alpha",
        "drupal/crop": "^2.4",
        "drupal/ctools": "^4.0",
        "drupal/core-composer-scaffold": "^11.0",
        "drupal/core-project-message": "^11.0",
        "drupal/core-recommended": "^11.0",
        "drupal/diff": "^2.0@beta",
        "drupal/disable_html5_validation": "^2.0",
        "drupal/dynamic_entity_reference": "^4.0@alpha",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/entity": "^1.5",
        "drupal/entity_browser": "^2.6",
        "drupal/entity_reference_revisions": "^1.10",
        "drupal/entity_usage": "^2.0@beta",
        "drupal/environment_indicator": "^4.1@beta",
        "drupal/facets": "^3.0@beta",
        "drupal/field_group": "^4.0@alpha",
        "drupal/flexible_permissions": "^2.0",
        "drupal/focal_point": "^2.0",
        "drupal/fullcalendar_view": "^5.2",
        "drupal/geocoder": "^4.23",
        "drupal/geofield": "^1.35",
        "drupal/geolocation": "^4.0@alpha",
        "drupal/gin": "^5.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/group": "^3.3",
        "drupal/honeypot": "^2.2",
        "drupal/image_widget_crop": "^3.0",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/jquery_ui": "^1.7",
        "drupal/jquery_ui_autocomplete": "^2.1",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/jquery_ui_menu": "^2.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/json_field": "^1.7",
        "drupal/key": "^1.18",
        "drupal/layout_paragraphs": "^3.0@alpha",
        "drupal/leaflet": "^10.0",
        "drupal/leaflet_more_maps": "^2.1",
        "drupal/leaflet_more_markers": "^1.1",
        "drupal/login_emailusername": "^3.0",
        "drupal/masquerade": "^2.0",
        "drupal/material_base": "^3.1",
        "drupal/message": "^1.4",
        "drupal/message_notify": "^1.4",
        "drupal/metatag": "^2.2",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.1",
        "drupal/module_filter": "^5.0",
        "drupal/name": "^1.0@RC",
        "drupal/node_view_permissions": "^2.0",
        "drupal/paragraphs": "^1.12",
        "drupal/pathauto": "^1.8",
        "drupal/photoswipe": "^5.0",
        "drupal/physical": "^1.3",
        "drupal/publication_date": "^3.1",
        "drupal/recaptcha": "^3.0",
        "drupal/redirect": "^1.6",
        "drupal/search_api": "^1.35",
        "drupal/search_api_autocomplete": "^1.9",
        "drupal/search_api_block": "^1.1",
        "drupal/search_api_location": "^1.0@alpha",
        "drupal/search_api_solr": "^4.3",
        "drupal/search_api_sorts": "^1.2",
        "drupal/select2": "^2.0",
        "drupal/selective_better_exposed_filters": "^3.0",
        "drupal/smart_date": "^4.2",
        "drupal/smart_date_calendar_kit": "^2.2",
        "drupal/smart_trim": "^2.0",
        "drupal/social_api": "^4.1@beta",
        "drupal/social_auth": "^4.2@beta",
        "drupal/social_auth_google": "^4.0",
        "drupal/svg_image": "^3.2",
        "drupal/symfony_mailer": "^2.0",
        "drupal/symfony_mailer_log": "^1.2",
        "drupal/time_formatter": "^2.0",
        "drupal/token": "^1.15",
        "drupal/twig_field_value": "^2.0",
        "drupal/twig_tweak": "^3.1",
        "drupal/views_bulk_operations": "^4.0",
        "drupal/views_dependent_filters": "^1.2",
        "drupal/viewsreference": "^2.0@beta",
        "drupal/webform": "^6.3@beta",
        "drupal/webform_views": "^5.0",
        "drupal/workbench": "^1.6",
        "drush/drush": "^13",
        "firebase/php-jwt": "^7.1",
        "geocoder-php/google-maps-provider": "^4.6",
        "league/oauth2-google": "^4.0",
        "noli42/chosen": "^3.0",
        "npm-asset/photoswipe-dynamic-caption-plugin": "^1.2",
        "npm-asset/select2": "^4.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "platformsh/config-reader": "^2.4",
        "unsettlingtrend/trend_personal": "^2.0",
        "unsettlingtrend/ut_base": "^1.0",
        "unsettlingtrend/ut_recipe": "^1.0",
        "unsettlingtrend/ut_utilities": "^1.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "drupal/core-dev": "^11.0"
    },
    "conflict": { "drupal/drupal": "*" },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "drupal-scaffold": { "locations": { "web-root": "web/" } },
        "patches-file": "patches/composer.patches.json",
        "merge-plugin": { "include": [ "web/modules/contrib/chosen/composer.libraries.json" ] },
        "installer-paths": {
            "web/core": [ "type:drupal-core" ],
            "web/libraries/{$name}": [ "type:drupal-library", "type:bower-asset", "type:npm-asset" ],
            "web/modules/contrib/{$name}": [ "type:drupal-module" ],
            "web/profiles/contrib/{$name}": [ "type:drupal-profile" ],
            "web/themes/contrib/{$name}": [ "type:drupal-theme" ],
            "drush/Commands/contrib/{$name}": [ "type:drupal-drush" ],
            "web/modules/custom/{$name}": [ "type:drupal-custom-module" ],
            "web/themes/custom/{$name}": [ "type:drupal-custom-theme" ],
            "recipes/{$name}": [ "type:drupal-recipe" ]
        },
        "installer-types": [ "bower-asset", "npm-asset" ],
        "drupal-core-project-message": {
            "post-create-project-cmd-message": [
                "",
                "  Trend project created. Next:",
                "    cd <dir> && lando start && lando composer install && lando build",
                "    lando drush site:install recipes/trend_personal -y \\",
                "      --account-name=admin --account-pass=admin \\",
                "      trend_personal.site_name=\"My Site\" trend_personal.site_mail=\"me@example.com\"",
                "    lando drush cex -y",
                "  Then apply add-ons as needed, e.g.:",
                "    lando drush recipe recipes/trend_personal/trend_place -y",
                ""
            ]
        }
    },
    "scripts": {
        "post-drupal-scaffold-cmd": [
            "patch -p1 < patches/enable_twig_debugging.patch"
        ]
    }
}
